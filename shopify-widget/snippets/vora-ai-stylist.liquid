{% comment %}
  VORA AI Bridal Stylist — chat widget
  1. Upload vora-widget.css and vora-widget.js to Shopify Assets.
  2. Paste {% render 'vora-ai-stylist' %} just before </body> in theme.liquid.
{% endcomment %}

<script>
  window.VORA_CONFIG = {
    apiUrl: 'https://voraz-ai.onrender.com',
    shopDomain: '{{ shop.permanent_domain }}',
    shopName: '{{ shop.name }}'
  };
</script>

{{ 'vora-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vora-widget.js' | asset_url }}" defer></script>